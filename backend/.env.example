# ============================================================
# 环境变量示例文件
# 使用方法：把本文件复制一份并改名为 .env，然后填写真实值
# 注意：
#   · .env 内含密钥，绝不能提交到 Git，也不能被前端读取
#   · 前端只通过后端代理访问 AI，密钥只存在于后端
# ============================================================

# --- 阶段2：DeepSeek 对话（OpenAI 兼容接口）---
# 在这里申请密钥：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# 接口地址（DeepSeek 官方，一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 对话模型名（演示用 flash：快、便宜；需要更强可改 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-flash

# --- 通义在线中文向量（embedding；留空则自动回退本地占位向量）---
# 申请：阿里云百炼 https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-你的通义百炼密钥
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
